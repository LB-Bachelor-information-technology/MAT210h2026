   "source": [
    "from math import factorial\n",
    "\n",
    "def back(n:int, r:int=-1):\n",
    "    r = n if r <= 0 else r\n",
    "    return factorial(n)/factorial(n-r)\n",
    "\n",
    "def choose(n:int, r:int=-1):\n",
    "    r = 0 if r <= 0 else r\n",
    "    return back(n,r)/factorial(r)\n",
    "\n",
    "print(choose(8))"
   ]
  }
 ],
